# The app connects as notibondi_app: it reads everything and writes only
# route_names. Migrations and the imports use the owner (ADMIN_DATABASE_URL).
# APP_DB_PASSWORD is the same password as in DATABASE_URL, for docker compose.
# Passwords go inside URLs: use only letters and digits, or URL-encode them
DATABASE_URL=postgresql+psycopg://notibondi_app:apppassword@localhost:5432/notibondi
ADMIN_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/notibondi
APP_DB_PASSWORD=apppassword

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=notibondi

GCBA_CLIENT_ID=
GCBA_CLIENT_SECRET=

# gcba (default), fixtures (recorded 108 feeds, no network) or off
LIVE_FEEDS=gcba
